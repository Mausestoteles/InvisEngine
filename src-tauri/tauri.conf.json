{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InvisEngine",
  "version": "0.1.0",
  "identifier": "dev.mausi.invisengine",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "InvisEngine",
        "width": 720,
        "height": 480,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
